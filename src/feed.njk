---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>GA4 Optimizer Blog</title>
  <subtitle>Tips, tutorials, and updates for Google Analytics 4 power users.</subtitle>
  <link href="https://www.gaoptimizer.com/feed.xml" rel="self" type="application/atom+xml"/>
  <link href="https://www.gaoptimizer.com/" rel="alternate" type="text/html"/>
  <id>https://www.gaoptimizer.com/</id>
  <updated>{{ collections.posts[0].date | isoDate }}</updated>
  <author>
    <name>GA4 Optimizer</name>
  </author>
  {%- for post in collections.posts.slice(0, 20) %}
  {%- if not post.data.exclude_from_feed %}
  <entry>
    <title>{{ post.data.title }}</title>
    <link href="https://www.gaoptimizer.com{{ post.url }}" rel="alternate" type="text/html"/>
    <id>https://www.gaoptimizer.com{{ post.url }}</id>
    <published>{{ post.date | isoDate }}</published>
    <updated>{{ (post.data.last_modified_at or post.date) | isoDate }}</updated>
    <summary>{{ post.data.description }}</summary>
  </entry>
  {%- endif %}
  {%- endfor %}
</feed>
