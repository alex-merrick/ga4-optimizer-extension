---
layout: "layouts/base.njk"
eleventyComputed:
  schema: |
    {%- set articleSchema = {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": title,
      "datePublished": page.date.toISOString(),
      "dateModified": last_modified_at if last_modified_at else page.date.toISOString(),
      "author": {
        "@type": "Person",
        "name": author | default("The GA4 Optimizer Team")
      },
      "publisher": {
          "@type": "Organization",
          "name": "GA4 Optimizer",
          "logo": {
            "@type": "ImageObject",
            "url": "https://www.gaoptimizer.com/icons/ga4-optimizer-logo.png"
          }
      },
      "image": {
          "@type": "ImageObject",
          "url": "https://www.gaoptimizer.com" + (post_image or thumbnail)
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://www.gaoptimizer.com" + page.url
      }
    } -%}
    {%- if faq_schema -%}
      {%- set combinedSchema = {
        "@context": "https://schema.org",
        "@graph": [
          articleSchema,
          faq_schema | fromJson
        ]
      } -%}
      {{- combinedSchema | dump | safe -}}
    {%- else -%}
      {{- articleSchema | dump | safe -}}
    {%- endif -%}
---
{# 
    NOTE: All schema generation logic has been moved to the front matter above.
    This template's only job is now to render the page content. 
#}
<main class="container">
    <div class="main-content content-page">

        {# NEW: Added a dedicated container for the post header #}
        <div class="post-header-container">
            {# Text content is now in its own div for layout control #}
            <div class="post-header-text">
                <h1>{{ title }}</h1>
                <p class="post-meta" style="color: var(--text-light); font-style: italic;">
                    Published on {{ page.date.toDateString() }}
                    {%- if tags -%}
                        {%- if 'ga4-updates' in tags -%}
                            <a href="/blog/ga4-updates/" class="post-hub-badge">GA4 Updates</a>
                        {%- endif -%}
                        {%- if 'gtm-updates' in tags -%}
                            <a href="/blog/gtm-updates/" class="post-hub-badge">GTM Updates</a>
                        {%- endif -%}
                        {%- if 'ga4-fixes' in tags -%}
                            <a href="/blog/ga4-fixes/" class="post-hub-badge">GA4 Fixes</a>
                        {%- endif -%}
                    {%- endif -%}
                </p>
            </div>
            
            {# Image content is now in its own div for layout control #}
            {% if show_hero != false %}
            <div class="post-header-image">
                {# --- Smart Image Selection Logic --- #}
                {% set desktop_image = post_image or thumbnail %}
                {% set mobile_image = thumbnail or post_image %}

                {# --- Output Both Images with Specific Classes --- #}
                {% if desktop_image %}
                    <img src="{{ desktop_image }}" alt="{{ title }}" class="post-banner-image post-banner-desktop" width="1120" height="560">
                {% endif %}

                {% if mobile_image %}
                    <img src="{{ mobile_image }}" alt="{{ title }}" class="post-banner-image post-banner-mobile" width="600" height="400">
                {% endif %}
            </div>
            {% endif %}
        </div>

        <!-- Social Share Buttons - Top of Post -->
        {% set hideHeading = true %}
        {% include "social-share.njk" %}
        {% set hideHeading = false %}

        <article class="post-body">
            {{ content | safe }}
        </article>

        <!-- Social Share Buttons - Bottom of Post -->
        {% include "social-share.njk" %}

        <!-- Optional: Floating Social Share Sidebar (uncomment to enable) -->
        {# {% include "social-share-floating.njk" %} #}

        <hr style="margin-top: 40px; border-color: var(--border-color);">

        <section class="toolkit-cta" aria-label="Our free GA4 and GTM toolkit">
            <h3 class="toolkit-cta__heading">Our Free GA4 &amp; GTM Toolkit</h3>
            <div class="toolkit-cta__grid">
                <div class="toolkit-card">
                    <img src="/icons/ga4-optimizer-logo.png" alt="GA4 Optimizer icon" class="toolkit-card__icon" width="48" height="48">
                    <h4 class="toolkit-card__title">GA4 Optimizer</h4>
                    <p class="toolkit-card__desc">Enhance GA4 reports with 1-click date presets, advanced filters, and custom metrics.</p>
                    <a href="https://chromewebstore.google.com/detail/ga4-optimizer/hlldjkhoepkephgaeifgbelgchncfnjj?utm_source=gaoptimizer.com&amp;utm_medium=website&amp;utm_campaign=blog_post_toolkit" class="cta-button toolkit-card__button" target="_blank" rel="noopener">
                        Add to Chrome
                    </a>
                </div>
                <div class="toolkit-card">
                    <img src="/icons/ga4-live-debugger/icon128.png" alt="GA4 Live Debugger icon" class="toolkit-card__icon" width="48" height="48">
                    <h4 class="toolkit-card__title">GA4 Live Debugger</h4>
                    <p class="toolkit-card__desc">Monitor dataLayer pushes, validate ecommerce schemas, and block test hits locally.</p>
                    <a href="https://chromewebstore.google.com/detail/akkagamamkhledgmhlljcdiodkgeeiob/?utm_source=gaoptimizer.com&amp;utm_medium=website&amp;utm_campaign=blog_post_toolkit" class="cta-button toolkit-card__button" target="_blank" rel="noopener">
                        Get the Debugger
                    </a>
                </div>
            </div>
        </section>

        <!-- Recommended Articles -->
        {% include "recommended-articles.njk" %}

    </div>
</main>